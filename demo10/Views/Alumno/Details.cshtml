@model AlumnoModel
@{ ViewData["Title"] = "Ficha del alumno"; }
<a class="back-link" asp-action="Index">← Volver al directorio</a><div class="page-heading"><div><p class="eyebrow">FICHA ACADÉMICA · #@Model.Id.ToString("D4")</p><h1>@Model.Nombres @Model.Apellidos<span class="heading-dot">.</span></h1><p class="subtitle">Una visión completa de su perfil.</p></div><a class="button primary" asp-action="Edit" asp-route-id="@Model.Id">Editar información ↗</a></div><section class="profile-card"><div class="profile-head"><span class="student-avatar large tone-@(Model.Id%4)">@Model.Nombres[0]@Model.Apellidos[0]</span><div><h2>@Model.Nombres @Model.Apellidos</h2><p>@Model.Carrera</p></div><span class="badge badge-@Model.Estado.ToLowerInvariant()"><i class="dot"></i>@Model.Estado</span></div><dl class="detail-grid"><div><dt>Documento de identidad</dt><dd>@Model.Documento</dd></div><div><dt>Correo electrónico</dt><dd><a href="mailto:@Model.Correo">@Model.Correo</a></dd></div><div><dt>Teléfono</dt><dd>@(Model.Telefono??"Sin registrar")</dd></div><div><dt>Ciclo académico</dt><dd>Ciclo @Model.Ciclo.ToString("D2")</dd></div><div><dt>Fecha de registro (UTC)</dt><dd>@Model.FechaRegistro</dd></div><div class="full"><dt>Observaciones</dt><dd>@(Model.Observaciones??"Sin observaciones")</dd></div></dl></section>
