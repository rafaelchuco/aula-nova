@model AlumnosIndexModel
@{ ViewData["Title"] = "Alumnos"; }
<div class="page-heading"><div><p class="eyebrow">COMUNIDAD ACADÉMICA</p><h1>Alumnos<span class="heading-dot">.</span></h1><p class="subtitle">Conoce, organiza y acompaña a tu comunidad estudiantil.</p></div><a class="button primary" asp-action="Create"><span aria-hidden="true">＋</span> Nuevo alumno</a></div>
<section class="stats" aria-label="Resumen de alumnos"><article class="stat-card"><div class="stat-top">Total de alumnos <span aria-hidden="true">♧</span></div><strong>@Model.Total.ToString("D2")</strong><small>Tu comunidad, en un solo lugar</small></article><article class="stat-card"><div class="stat-top">Alumnos activos <span class="green" aria-hidden="true">↗</span></div><strong>@Model.Activos.ToString("D2")</strong><small><i class="dot green-bg"></i> En formación</small></article><article class="stat-card"><div class="stat-top">Egresados <span aria-hidden="true">◇</span></div><strong>@Model.Egresados.ToString("D2")</strong><small>Listos para su siguiente etapa</small></article><article class="stat-card accent"><div class="stat-top">Carreras con alumnos <span aria-hidden="true">✳</span></div><strong>@Model.CarrerasRegistradas.ToString("D2")</strong><small>Distintos caminos, un mismo futuro</small></article></section>
<section class="directory"><div class="section-heading"><div><h2>Directorio de alumnos <span class="count">@Model.Alumnos.Count</span></h2><p>La información que necesitas, siempre a mano.</p></div><span class="directory-label">REGISTRO ACADÉMICO</span></div>
<form method="get" asp-action="Index" class="filters" role="search"><div class="search-box"><span aria-hidden="true">⌕</span><label class="sr-only" for="buscar">Buscar alumno</label><input id="buscar" name="buscar" value="@Model.Buscar" placeholder="Buscar por nombre, documento o correo…" /></div><label class="sr-only" for="carrera">Filtrar por carrera</label><select id="carrera" name="carrera"><option value="">Todas las carreras</option>@foreach(var c in AlumnoModel.Carreras){<option value="@c" selected="@(Model.Carrera==c)">@c</option>}</select><label class="sr-only" for="estado">Filtrar por estado</label><select id="estado" name="estado"><option value="">Todos los estados</option>@foreach(var e in new[]{"Activo","Egresado","Inactivo"}){<option value="@e" selected="@(Model.Estado==e)">@e</option>}</select><button class="button secondary" type="submit">Filtrar</button>@if(!string.IsNullOrEmpty(Model.Buscar)||!string.IsNullOrEmpty(Model.Carrera)||!string.IsNullOrEmpty(Model.Estado)){<a class="clear-link" asp-action="Index">Limpiar</a>}</form>
<div class="table-wrap"><table><thead><tr><th>ALUMNO</th><th>DOCUMENTO</th><th>CARRERA / CICLO</th><th>ESTADO</th><th class="actions-head">ACCIONES</th></tr></thead><tbody>@foreach(var a in Model.Alumnos){<tr><td><div class="student"><span class="student-avatar tone-@(a.Id%4)">@a.Nombres[0]@a.Apellidos[0]</span><div><a class="student-name" asp-action="Details" asp-route-id="@a.Id">@a.Nombres @a.Apellidos</a><small>@a.Correo</small></div></div></td><td class="document">@a.Documento</td><td><span class="career">@a.Carrera</span><small>Ciclo @a.Ciclo.ToString("D2")</small></td><td><span class="badge badge-@a.Estado.ToLowerInvariant()"><i class="dot"></i>@a.Estado</span></td><td><div class="row-actions"><a asp-action="Details" asp-route-id="@a.Id" aria-label="Ver a @a.Nombres" title="Ver ficha">↗</a><a asp-action="Edit" asp-route-id="@a.Id" aria-label="Editar a @a.Nombres" title="Editar">✎</a><a class="delete-link" asp-action="Delete" asp-route-id="@a.Id" aria-label="Eliminar a @a.Nombres" title="Eliminar">×</a></div></td></tr>}</tbody></table></div>
@if(Model.Alumnos.Count==0){<div class="empty-state"><span aria-hidden="true">▦</span><h3>@(Model.Total==0?"Tu comunidad empieza aquí":"No encontramos coincidencias")</h3><p>@(Model.Total==0?"Registra tu primer alumno para comenzar.":"Prueba con otro nombre o ajusta los filtros.")</p>@if(Model.Total==0){<a class="button primary" asp-action="Create">Registrar primer alumno</a>}else{<a class="button secondary" asp-action="Index">Ver todos los alumnos</a>}</div>}
<div class="table-footer"><span>@Model.Alumnos.Count de @Model.Total alumnos</span><span>Un registro actualizado abre más oportunidades <span class="green">↗</span></span></div></section><div class="bottom-note"><span aria-hidden="true">✧</span> Todo empieza con una oportunidad de aprender.</div>
