@model LaboratorioCRUDAlumnos.Models.AlumnoModel
@{ ViewBag.Title = "Ficha del alumno"; }
<a class="back-link" href="@Url.Action("Index")">← Volver al directorio</a>
<section class="profile-layout"><aside class="profile-cover"><p class="eyebrow">CADA HISTORIA CUENTA</p><span class="profile-avatar">@Model.Nombres[0]@Model.Apellidos[0]</span><span class="profile-id">ALUMNO #@Model.Id.ToString("D3")</span><h1>@Model.Nombres<br /><span>@Model.Apellidos</span></h1><div class="profile-decoration" aria-hidden="true">✳</div></aside><div class="profile-data"><div class="card-heading"><span class="section-number">↗</span><div><h2>Un vistazo a su historia</h2><p>Información del alumno en tu directorio.</p></div></div><dl class="details-list"><div><dt>Identificador</dt><dd>#@Model.Id.ToString("D3")</dd></div><div><dt>Nombres</dt><dd>@Model.Nombres</dd></div><div><dt>Apellidos</dt><dd>@Model.Apellidos</dd></div><div><dt>Correo electrónico</dt><dd><a href="mailto:@Model.Correo">@Model.Correo</a></dd></div><div><dt>Edad</dt><dd>@Model.Edad años</dd></div></dl><div class="profile-actions"><a class="button button-blue" href="@Url.Action("Edit", new { id = Model.Id })">Editar información ↗</a><a class="text-link muted-link" href="@Url.Action("Delete", new { id = Model.Id })">Eliminar alumno</a></div></div></section>
